 1 file changed, 31 insertions(+), 6 deletions(-)

diff --git a/src/rustc_ast/tokenstream.rs b/src/rustc_ast/tokenstream.rs
index 1cec9042f7f9d932cf33d9714499995304661511..6182fa91b6371f885b0f29f64aabec4c74e261c4 100644
--- a/src/rustc_ast/tokenstream.rs
