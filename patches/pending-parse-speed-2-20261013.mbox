From: meh <no-reply@pathscale.com>
Date: Tue, 13 Oct 2026 01:13:09 +0700
Subject: [PATCH 08/23] Skip whitespace runs in place in the lexer instead of
 building Whitespace tokens

---
 src/rustc_lexer/mod.rs       | 18 ++++++++++++++++++
 src/rustc_parse/lexer/mod.rs |  6 ++++++
 2 files changed, 24 insertions(+)

diff --git a/src/rustc_lexer/mod.rs b/src/rustc_lexer/mod.rs
index bf10e4e1a577781bf8bdb0258538f7422dc540e0..cc87ff76bbe5d5247c582fbfa31caf56a7c3371a 100644
--- a/src/rustc_lexer/mod.rs
+++ b/src/rustc_lexer/mod.rs
@@ -666,6 +666,24 @@ impl<'a> Cursor<'a> {
         }
     }
 
+    /// Eats a run of whitespace that starts with an ASCII whitespace byte, once a frontmatter
+    /// can no longer start, and returns its length (0 when the next byte is not one). The run
+    /// is the one a `Whitespace` token from `advance_token` would cover, without building it.
+    #[inline(always)]
+    pub fn skip_whitespace(&mut self) -> u32 {
+        // Tab, line feed, vertical tab, form feed, carriage return, space.
+        if matches!(self.frontmatter_allowed, FrontmatterAllowed::No)
+            && let Some(&b) = self.as_str().as_bytes().first()
+            && matches!(b, 0x09..=0x0D | 0x20)
+        {
+            self.eat_whitespace();
+            let len = self.pos_within_token();
+            self.reset_pos_within_token();
+            return len;
+        }
+        0
+    }
+
     /// Parses a token from the input string.
     #[inline]
     pub fn advance_token(&mut self) -> Token {
diff --git a/src/rustc_parse/lexer/mod.rs b/src/rustc_parse/lexer/mod.rs
