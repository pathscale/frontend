+++ b/src/rustc_parse/lexer/mod.rs
@@ -243,6 +243,12 @@ impl<'psess, 'src> Lexer<'psess, 'src> {
         let mut swallow_next_invalid = 0;
         // Skip trivial (whitespace & comments) tokens
         loop {
+            // Whitespace is skipped in place rather than built as a token first.
+            let skipped = self.cursor.skip_whitespace();
+            if skipped != 0 {
+                self.pos = self.pos + BytePos(skipped);
+                preceded_by_whitespace = true;
+            }
             let str_before = self.cursor.as_str();
             let token = self.cursor.advance_token();
             let start = self.pos;

From c5ba3d7574189a533a5110875da688b79790b00d Mon Sep 17 00:00:00 2001
From: meh <no-reply@pathscale.com>
Date: Tue, 13 Oct 2026 01:24:42 +0700
Subject: [PATCH 09/23] Add a default-off rusty_alloc feature that sets
 ps-rusty_alloc as the frontend-facts allocator

---
 Cargo.toml                | 4 ++++
 src/bin/frontend_facts.rs | 4 ++++
 2 files changed, 8 insertions(+)

diff --git a/Cargo.toml b/Cargo.toml
index a290215a9dcc4806f50546b7429512be77e77b69..c984b487d024b6c6422256f1b1b7f5211e20a51b 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -59,6 +59,9 @@ force_pinned_sysroot = []
 # default: nothing else in the crate calls them, and a caller who does not want them does not
 # compile them.
 diagnostics = []
+# Make ps-rusty_alloc the global allocator of the `frontend-facts` binary. Off by default: the
+# library never sets a global allocator, and a binary that links it picks its own.
+rusty_alloc = ["dep:rusty_alloc"]
 # Run a parallel session's stages (`rustc_data_structures::sync::stages`) on nagoya's pool. Off
 # by default, and the default build is the serial compiler exactly as it was, with no `nagoya`
 # and no `std` in its graph.
@@ -113,6 +116,7 @@ rand_xoshiro = "0.7.0"
 rustc-demangle = "0.1.28"
 rustc_apfloat = "0.2.3"
 rustc-hash = { version = "2.0.0", default-features = false }
+rusty_alloc = { package = "ps-rusty_alloc", version = "2", optional = true }
 rustc-literal-escaper = "0.0.8"
 serde = { version = "1.0.219", default-features = false, features = ["alloc", "derive", "rc"] }
 serde_derive = "1.0.219"
diff --git a/src/bin/frontend_facts.rs b/src/bin/frontend_facts.rs
index 8f31e57a689f5c4f0f935da721edd1d956a389bf..303d1978e26226b5472d719c0f20824659a3e3ae 100644
--- a/src/bin/frontend_facts.rs
+++ b/src/bin/frontend_facts.rs
@@ -37,6 +37,10 @@
 
 use frontend::frontend_facts::{CrateRead, Dependency, Loaded};
 
+#[cfg(feature = "rusty_alloc")]
+#[global_allocator]
+static GLOBAL: rusty_alloc::RustyAlloc = rusty_alloc::RustyAlloc;
+
 fn catcher(f: &mut dyn FnMut()) -> Result<(), frontend::unwind_janky::Payload> {
     std::panic::catch_unwind(std::panic::AssertUnwindSafe(f))
 }

