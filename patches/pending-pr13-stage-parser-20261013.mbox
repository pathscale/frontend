+                lifetimes_res_map
+                    .into_items()
+                    .map(move |(id, res)| (renumber(id), renumber_lifetime_res(res, renumber))),
+            );
+            data.extra_lifetime_params_map.extend_unord(extra_lifetime_params_map.into_items().map(
