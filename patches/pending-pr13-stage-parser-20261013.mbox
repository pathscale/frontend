+    // so it lands wholly inside a chunk, straddles each boundary position, and ends in
+    // the tail; a newline right after it checks the line positions that follow.
+    for c in ['\u{e9}', '\u{394}', '\u{2028}', '\u{20ac}', '\u{1f600}'] {
+        for prefix in 0..48 {
