+/// outlives bounds its argument implies (`'a: 'r`, `'tcx: 'r`) are what the coercion checks.
+fn as_enterable<'r, 'a, 'tcx>(icx: &'r ImplicitCtxt<'a, 'tcx>) -> &'r (dyn EnterImplicitCtxt + 'r) {
+    icx
