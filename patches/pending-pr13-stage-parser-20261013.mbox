+            pat_span_map,
+            privacy_errors,
+            ambiguity_errors,
+            issue_145575_hack_applied,
+            macro_expanded_macro_export_errors,
+            lint_buffer,
+            import_use_map,
+            used_imports,
+            glob_map,
+            maybe_unused_trait_imports,
+        } = sink;
