diff --git a/src/rustc_ast/tokenstream.rs b/src/rustc_ast/tokenstream.rs
index 1cec9042f7f9d932cf33d9714499995304661511..424255309f2b02b926a0ef20f3a54430b7adca91 100644
--- a/src/rustc_ast/tokenstream.rs
