From: meh <no-reply@pathscale.com>
Date: Mon, 12 Oct 2026 17:18:47 +0700
Subject: [PATCH 1/9] Share one empty token stream per lexer instead of
 allocating each

---
 src/rustc_parse/lexer/mod.rs        | 4 ++++
 src/rustc_parse/lexer/tokentrees.rs | 7 +++++++
 2 files changed, 11 insertions(+)

diff --git a/src/rustc_parse/lexer/mod.rs b/src/rustc_parse/lexer/mod.rs
index a8ee2379dc2505f95d0c201c9207cc1476d36b03..285ef6883c576a5e6be1ae3c569e2c458a27a573 100644
--- a/src/rustc_parse/lexer/mod.rs
+++ b/src/rustc_parse/lexer/mod.rs
@@ -104,6 +104,7 @@ pub(crate) fn lex_token_trees<'psess, 'src>(
         token: Token::dummy(),
         diag_info: TokenTreeDiagInfo::default(),
         tree_buf: Vec::new(),
+        empty_stream: None,
         gallery_seen: Vec::new(),
         gallery_new: Vec::new(),
     };
@@ -162,6 +163,9 @@ struct Lexer<'psess, 'src> {
     /// See `lex_token_trees`.
     tree_buf: Vec<TokenTree>,
 
+    /// Shared backing stream for empty groups.
+    empty_stream: Option<TokenStream>,
+
     /// The session's `symbol_gallery` keeps each symbol's first occurrence, so of the
     /// identifiers this lexer records only the first of each symbol can change it, and nothing
     /// else touches the gallery while a lexer runs. A lexer therefore records a symbol once, in
diff --git a/src/rustc_parse/lexer/tokentrees.rs b/src/rustc_parse/lexer/tokentrees.rs
index 870a6fb25eeb1d1b1b37c96b3c28905074edf00d..cca716e89bdc8f0843af8e0506efe6d9c2100b72 100644
--- a/src/rustc_parse/lexer/tokentrees.rs
+++ b/src/rustc_parse/lexer/tokentrees.rs
@@ -65,6 +65,13 @@ impl<'psess, 'src> Lexer<'psess, 'src> {
     /// `Vec` has exactly their length as capacity (`Drain` is `TrustedLen`,
     /// so `collect` allocates once, and not at all for an empty group).
     fn take_trees(&mut self, start: usize) -> TokenStream {
+        if start == self.tree_buf.len() {
+            return self
+                .empty_stream
+                .get_or_insert_with(|| TokenStream::new(Vec::new()))
+                .clone();
+        }
+
         let tts: Vec<TokenTree> = self.tree_buf.drain(start..).collect();
         TokenStream::new(tts)
     }

