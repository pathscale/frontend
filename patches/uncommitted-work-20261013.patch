-args=$(cargo rustc --manifest-path link-probe/Cargo.toml --bin link-probe -- --print=link-args 2>"$err") || {
+args=$(cargo rustc --offline --locked --manifest-path "$probe_manifest" --bin link-probe -- --print=link-args 2>"$err") || {
