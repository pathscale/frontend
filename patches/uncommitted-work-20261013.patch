+        &pattern_source,
+        owner_source,
+        DefinitionSourceKind::TraitImplementation,
+    );
+    assert!(owner_item.contains("unsafe impl<'a> Searcher<'a> for CharSearcher<'a>"));
+    assert_core_context(&owner_source.source_context, context);
+}
