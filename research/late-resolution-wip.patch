+            CmResolver::Late(_, sink) => &mut sink.glob_map,
+            CmResolver::Ref(_) => write_through_immutable_resolver(),
+        }
+    }
+
+    /// Record an ambiguity error. With `dedup`, an error equal to one already recorded is
+    /// dropped (`record_use`'s rule); without it, it is always kept (`maybe_push_ambiguity`'s).
+    ///
+    /// A late unit sees only the errors recorded before late resolution and its own, so it
+    /// drops what it can see and keeps the rest marked; `Resolver::merge_late_sink` applies
+    /// the same test again against everything merged before it, which is every error the one
+    /// crate walk had recorded at that point. So the merged vector is the walk's, in its order.
+    #[track_caller]
+    fn push_ambiguity_error(&mut self, error: AmbiguityError<'ra>, dedup: bool) {
+        match self {
+            CmResolver::Mut(r) => {
+                if !dedup || !r.matches_previous_ambiguity_error(&error) {
+                    r.ambiguity_errors.push(error);
+                }
+            }
+            CmResolver::Late(r, sink) => {
+                if dedup
+                    && (r.matches_previous_ambiguity_error(&error)
+                        || sink.matches_previous_ambiguity_error(&error))
+                {
+                    return;
+                }
+                sink.ambiguity_errors.push((error, dedup));
             }
+            CmResolver::Ref(_) => write_through_immutable_resolver(),
+        }
+    }
+
+    #[track_caller]
+    fn set_issue_145575_hack_applied(&mut self) {
+        match self {
+            CmResolver::Mut(r) => r.issue_145575_hack_applied = true,
+            CmResolver::Late(_, sink) => sink.issue_145575_hack_applied = true,
+            CmResolver::Ref(_) => write_through_immutable_resolver(),
+        }
+    }
+
+    /// The partial resolution recorded for `id`, the unit's own first for a late unit.
+    fn partial_res(&self, id: NodeId) -> Option<PartialRes> {
+        match self {
+            CmResolver::Late(r, sink) => sink.partial_res(r, id),
+            CmResolver::Ref(r) => r.partial_res_map.get(&id).copied(),
+            CmResolver::Mut(r) => r.partial_res_map.get(&id).copied(),
+        }
+    }
+
+    #[track_caller]
+    fn record_partial_res(&mut self, node_id: NodeId, resolution: PartialRes) {
+        match self {
+            CmResolver::Mut(r) => r.record_partial_res(node_id, resolution),
+            CmResolver::Late(r, sink) => sink.record_partial_res(r, node_id, resolution),
+            CmResolver::Ref(_) => write_through_immutable_resolver(),
         }
     }
 
+    /// The span of the binding pattern `id`, the unit's own first for a late unit.
+    fn pat_span(&self, id: NodeId) -> Option<Span> {
+        match self {
+            CmResolver::Late(r, sink) => sink.pat_span(r, id),
+            CmResolver::Ref(r) => r.pat_span_map.get(&id).copied(),
+            CmResolver::Mut(r) => r.pat_span_map.get(&id).copied(),
+        }
+    }
+
+    /// Mark `import` used, as `used`: the stronger of two marks wins, and its node counts as a
+    /// used import for `check_unused`.
+    #[track_caller]
+    fn record_import_use(&mut self, import: Import<'ra>, used: Used) {
+        let (import_use_map, used_imports) = match self {
+            CmResolver::Mut(r) => (&mut r.import_use_map, &mut r.used_imports),
+            CmResolver::Late(_, sink) => (&mut sink.import_use_map, &mut sink.used_imports),
+            CmResolver::Ref(_) => write_through_immutable_resolver(),
+        };
+        let old_used = import_use_map.entry(import).or_insert(used);
+        if *old_used < used {
+            *old_used = used;
+        }
+        if let Some(id) = import.id() {
+            used_imports.insert(id);
+        }
+    }
+}
+
+/// Whether two ambiguity errors are the same error: the rule `record_use` deduplicates by.
+fn same_ambiguity_error(a: &AmbiguityError<'_>, b: &AmbiguityError<'_>) -> bool {
+    // if the span location and ident as well as its span are the same
+    a.kind == b.kind
+        && a.ident == b.ident
+        && a.ident.span == b.ident.span
+        && a.b1.span == b.b1.span
+        && a.b2.span == b.b2.span
+}
+
+/// What one unit of late resolution writes into the resolver's shared tables through name
+/// lookup, kept by the unit instead (`CmResolver::Late`) and merged into the resolver in unit
+/// order by `Resolver::merge_late_sink`.
+///
+/// Each field stands for the resolver field of the same name. Which reads see it, and how it
+/// merges:
+///
+/// - `partial_res_map`, `pat_span_map`: keyed by nodes of the unit's own items, so no two units
+///   write one key. Read back during the unit (a path's `Self` type, a pattern's span for a
+///   diagnostic, `legacy_const_generic_args`) through `partial_res` and `pat_span`, which look
+///   here first. Merged by inserting every entry; order cannot matter.
+/// - `ambiguity_errors`: in the order found, each marked with whether `record_use`'s dedup
+///   applies to it; see `CmResolver::push_ambiguity_error`.
+/// - `privacy_errors`: in the order found; `resolve_path_with_ribs` rewrites the tail of this
+///   vector after its mark, which is the tail the crate walk rewrote. Concatenated.
+/// - `macro_expanded_macro_export_errors`: a set; union.
+/// - `lint_buffer`: lints by node, appended node by node, which is the order the walk buffered
+///   them in (a node's lints all come from its own unit, and the early lint pass takes a node's
+///   lints as a whole).
+/// - `import_use_map`, `used_imports`, `glob_map`, `maybe_unused_trait_imports`: monotone
+///   marks, merged by union (and the stronger `Used`), in unit order so that the ordered ones
+///   keep the order the walk gave them. Nothing reads them before `check_unused`.
+/// - `issue_145575_hack_applied`: a flag, or-ed in.
+#[derive(Default)]
+struct LateSink<'ra> {
+    partial_res_map: NodeMap<PartialRes>,
+    pat_span_map: NodeMap<Span>,
+    ambiguity_errors: Vec<(AmbiguityError<'ra>, bool)>,
+    privacy_errors: Vec<PrivacyError<'ra>>,
+    macro_expanded_macro_export_errors: BTreeSet<(Span, Span)>,
+    lint_buffer: LintBuffer,
+    import_use_map: FxHashMap<Import<'ra>, Used>,
+    used_imports: FxHashSet<NodeId>,
+    glob_map: FxIndexMap<LocalDefId, FxIndexSet<Symbol>>,
+    maybe_unused_trait_imports: FxIndexSet<LocalDefId>,
+    issue_145575_hack_applied: bool,
+}
+
+impl<'ra> LateSink<'ra> {
+    /// The partial resolution of `id`: the unit's own, else one recorded before late resolution.
+    fn partial_res(&self, r: &Resolver<'ra, '_>, id: NodeId) -> Option<PartialRes> {
+        self.partial_res_map.get(&id).or_else(|| r.partial_res_map.get(&id)).copied()
+    }
+
+    /// `Resolver::record_partial_res`, into the sink: the same "resolved twice" check, against
+    /// everything the unit can see (what came before late resolution, and its own).
+    fn record_partial_res(
+        &mut self,
+        r: &Resolver<'ra, '_>,
+        node_id: NodeId,
+        resolution: PartialRes,
+    ) {
+        debug!("(recording res) recording {:?} for {}", resolution, node_id);
+        let prev_res = self
+            .partial_res_map
+            .insert(node_id, resolution)
+            .or_else(|| r.partial_res_map.get(&node_id).copied());
+        if let Some(prev_res) = prev_res {
+            panic!("path resolved multiple times ({prev_res:?} before, {resolution:?} now)");
+        }
+    }
+
+    /// Only late resolution records pattern spans, so this is the only place they are recorded.
+    fn record_pat_span(&mut self, node: NodeId, span: Span) {
+        debug!("(recording pat) recording {:?} for {:?}", node, span);
+        self.pat_span_map.insert(node, span);
+    }
+
+    fn pat_span(&self, r: &Resolver<'ra, '_>, id: NodeId) -> Option<Span> {
+        self.pat_span_map.get(&id).or_else(|| r.pat_span_map.get(&id)).copied()
+    }
+
+    fn matches_previous_ambiguity_error(&self, ambi: &AmbiguityError<'_>) -> bool {
+        self.ambiguity_errors.iter().any(|(error, _)| same_ambiguity_error(error, ambi))
+    }
+}
